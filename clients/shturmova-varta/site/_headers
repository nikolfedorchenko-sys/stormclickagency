# Заголовки для Cloudflare Pages (https://developers.cloudflare.com/pages/configuration/headers/).
# Правило: якщо адреса підпадає під кілька блоків, однакові заголовки склеюються через кому,
# тому Cache-Control задаємо лише в окремих блоках, які не перетинаються.
# HTML-сторінки не чіпаємо: Pages віддає їх з «public, max-age=0, must-revalidate» – оновлення видно одразу.
# Стиснення (brotli/gzip) Pages вмикає сам.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https:; frame-src https://challenges.cloudflare.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests

# CSS і JS: у HTML на хостингу вони з ?v=<хеш вмісту> (tools/build-dist.cjs), тож кеш на рік безпечний –
# після зміни файлу змінюється адреса.
/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

# Шрифт міняється вкрай рідко; якщо оновите файли – дайте їм нові імена.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Фото, іконки, OG: імена без хешу – тиждень у браузері.
/img/*
  Cache-Control: public, max-age=604800

/icons/*
  Cache-Control: public, max-age=604800

# Технічна адреса *.pages.dev – не в пошук (прев’ю-збірки Pages закриває сам).
https://:project.pages.dev/*
  X-Robots-Tag: noindex
